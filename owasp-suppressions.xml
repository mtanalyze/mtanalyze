<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        log4j-core-only CVEs wrongly matched against log4j-api (shared CPE).
        Confirmed false positives by the DependencyCheck maintainers:
        https://github.com/dependency-check/DependencyCheck/issues/8456
        https://github.com/dependency-check/DependencyCheck/issues/8228
        We only ship log4j-api (transitively via poi-ooxml), never log4j-core.
    -->
    <suppress>
        <notes>log4j-core-only CVEs, not applicable to log4j-api</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j\-api@.*$</packageUrl>
        <cve>CVE-2026-34477</cve>
        <cve>CVE-2026-34478</cve>
        <cve>CVE-2026-34479</cve>
        <cve>CVE-2026-34480</cve>
        <cve>CVE-2026-34481</cve>
        <cve>CVE-2025-68161</cve>
    </suppress>
</suppressions>
